{
  "source": "pypi_immutable_distribution_metadata",
  "table": "bigquery-public-data.pypi.distribution_metadata",
  "query": "WITH source AS (\n  SELECT name, version, metadata_version, summary, requires_dist, requires_python, classifiers, project_urls, upload_time, filename, path, sha256_digest, size, python_version, packagetype\n  FROM `bigquery-public-data.pypi.distribution_metadata`\n  WHERE upload_time < TIMESTAMP(@end_date, 'UTC') OR upload_time IS NULL\n), candidates AS (\n  SELECT DISTINCT REGEXP_REPLACE(LOWER(name), r'[-_.]+', '-') AS package\n  FROM source\n  WHERE REGEXP_REPLACE(LOWER(name), r'[-_.]+', '-') IN UNNEST(@target_packages)\n     OR EXISTS (\n       SELECT 1 FROM UNNEST(requires_dist) AS requirement\n       WHERE REGEXP_REPLACE(LOWER(REGEXP_EXTRACT(requirement, r'^\\s*([A-Za-z0-9][A-Za-z0-9._-]*)')), r'[-_.]+', '-') IN UNNEST(@target_packages)\n     )\n)\nSELECT source.*\nFROM source\nJOIN candidates ON REGEXP_REPLACE(LOWER(name), r'[-_.]+', '-') = candidates.package\nORDER BY name, version, upload_time, filename, path",
  "query_parameters": [
